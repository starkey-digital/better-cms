{
	"name": "@better-cms/auth",
	"version": "0.3.0",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"author": "Starkey Digital Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/starkey-digital/better-cms.git",
		"directory": "packages/auth"
	},
	"description": "better-cms password auth plugin, signed-cookie sessions, rate limiting and Turnstile verification. Framework-agnostic.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"exports": {
		".": {
			"dev-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./better-auth": {
			"dev-source": "./src/better-auth.ts",
			"types": "./dist/better-auth.d.ts",
			"default": "./dist/better-auth.js"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "rm -rf dist && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@better-cms/core": "workspace:*"
	},
	"devDependencies": {
		"@libsql/client": "^0.17",
		"bun-types": "^1.3.7",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
