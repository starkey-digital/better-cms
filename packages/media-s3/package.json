{
	"name": "@better-cms/media-s3",
	"version": "0.3.0",
	"author": "Starkey Digital Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/starkey-digital/better-cms.git",
		"directory": "packages/media-s3"
	},
	"main": "./dist/index.js",
	"dependencies": {
		"@better-cms/core": "workspace:*",
		"aws4fetch": "^1.0.20"
	},
	"devDependencies": {
		"bun-types": "^1.3.7",
		"typescript": "^6.0.3"
	},
	"exports": {
