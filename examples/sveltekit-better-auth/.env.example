# One libsql database holds both the CMS content and better-auth's tables.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Where the site is served. better-auth builds the sign-in link from this.
BETTER_AUTH_URL=http://localhost:5173
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Comma-separated. These addresses become admins when they sign in.
# Required in production. Leave empty in development and the FIRST person to sign in becomes the admin instead.
ADMIN_EMAILS=

# Sending. Without RESEND_API_KEY the link is printed to the server console.
RESEND_API_KEY=
MAIL_FROM="My Site <login@example.com>"

# Photo uploads (optional). Leave S3_BUCKET empty to turn them off.
# Local: rclone serve s3 /tmp/bcms-s3 --addr 127.0.0.1:9000, then create the bucket folder:
#   mkdir -p /tmp/bcms-s3/bcms
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
